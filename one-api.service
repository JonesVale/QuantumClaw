# File path: /etc/systemd/system/quantumclaw.service
# sudo systemctl daemon-reload
# sudo systemctl start quantumclaw
# sudo systemctl enable quantumclaw
# sudo systemctl status quantumclaw
[Unit]
Description=QuantumClaw Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/quantumclaw  # 注意修改路径
ExecStart=/path/to/quantumclaw/quantumclaw --port 3000 --log-dir /path/to/quantumclaw/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

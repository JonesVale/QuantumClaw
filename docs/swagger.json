    "/v1/chat/completions": {
      "post": {
        "tags": [
          "Relay"
        ],
        "summary": "Chat completions (OpenAI-compatible)",
        "description": "Forward chat completion requests to configured AI models.\nSupports all OpenAI-compatible parameters.\nAuthentication: Bearer token.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "example": "gpt-4o"
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "temperature": {
                  "type": "number",
                  "default": 1
                },
                "max_tokens": {
                  "type": "integer"
                },
                "stream": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat completion response"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },

# ── QuantumClaw Environment ──
# 复制此文件为 .env 并修改配置

# Domain
DOMAIN=qscl.link
PORT=3666

# Database
MYSQL_ROOT_PASSWORD=quantumclaw
MYSQL_DATABASE=quantumclaw
MYSQL_USER=quantumclaw
MYSQL_PASSWORD=quantumclaw
SQL_DSN=root:quantumclaw@tcp(mysql:3306)/quantumclaw?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis-daae3a223e4e40f3907d

# Security
SESSION_SECRET=6b198275ddf2427f8db24532723ec924d9497245c3374dbeb2fd3f799358f991
INITIAL_ROOT_TOKEN=
INITIAL_ROOT_ACCESS_TOKEN=

# OAuth (社区版留空即可)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEBAUTHN_ENABLED=false

# SSL/HTTPS
# 部署 SSL 后，将 ServerAddress 改为 HTTPS 地址，
# 以便后端正确生成 OAuth 回调、邀请链接等
# (通过平台设置页面: 设置 → 系统名称和服务器地址)

# ============================================================
# QuantumClaw Environment Variables Example
# Copy this file to `.env` and modify the values
# ============================================================

# -----------------------
# Database
# -----------------------
# MySQL DSN (for docker-compose, use service name 'mysql')
SQL_DSN=root:quantumclaw@tcp(mysql:3306)/quantumclaw?charset=utf8mb4&parseTime=True&loc=Local
# SQLite (alternative to MySQL)
# Leave SQL_DSN empty or commented out, then set:
# SQLITE_PATH=./data/quantumclaw.db
# SQLITE_BUSY_TIMEOUT=3000

# Redis
REDIS=redis:6379
# REDIS_PASSWORD=your_redis_password

# -----------------------
# App Settings
# -----------------------
PORT=3666
GIN_MODE=release
DEBUG=false
DEBUG_SQL=false
SESSION_SECRET=your-session-secret-here-change-this
THEME=default

# Initial root token (required for first setup)
INITIAL_ROOT_TOKEN=your-root-token-here
INITIAL_ROOT_ACCESS_TOKEN=your-root-access-token-here

# Feature flags
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=600
ENABLE_METRIC=false
CHANNEL_TEST_FREQUENCY=300
BATCH_UPDATE_ENABLED=false

# -----------------------
# OAuth Providers
# -----------------------
# GitHub OAuth
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# WeChat OAuth
WECHAT_AUTH_ENABLED=false
WECHAT_CLIENT_ID=your-wechat-client-id
WECHAT_CLIENT_SECRET=your-wechat-client-secret

# Discord OAuth
DISCORD_OAUTH_ENABLED=false
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# LinuxDO OAuth
LINUXDO_OAUTH_ENABLED=false
LINUXDO_CLIENT_ID=your-linuxdo-client-id
LINUXDO_CLIENT_SECRET=your-linuxdo-client-secret

# Lark/Feishu OAuth
LARK_OAUTH_ENABLED=false
LARK_CLIENT_ID=your-lark-client-id
LARK_CLIENT_SECRET=your-lark-client-secret

# OIDC OAuth
OIDC_OAUTH_ENABLED=false
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_WELL_KNOWN=https://your-oidc-provider/.well-known/openid-configuration

# -----------------------
# WebAuthn/Passkey (NEW)
# -----------------------
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_DISPLAY_NAME=QuantumClaw
WEBAUTHN_RP_ID=         # Leave empty to auto-detect from ServerAddress
WEBAUTHN_ORIGIN=        # Leave empty to auto-detect from ServerAddress

# -----------------------
# SMTP (Email Verification)
# -----------------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_ACCOUNT=
SMTP_FROM=
SMTP_TOKEN=

# -----------------------
# Turnstile (Cloudflare CAPTCHA)
# -----------------------
TURNSTILE_CHECK_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------
# Payment - Stripe
# -----------------------
STRIPE_ENABLED=false
STRIPE_API_SECRET=
STRIPE_WEBHOOK_SECRET=

# -----------------------
# Payment - 易支付 (Epay)
# -----------------------
EPAY_ENABLED=false
EPAY_ID=
EPAY_KEY=
EPAY_ADDRESS=

# -----------------------
# Payment - Creem
# -----------------------
CREEM_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# -----------------------
# Payment - Waffo
# -----------------------
WAFFO_ENABLED=false
WAFFO_API_KEY=
WAFFO_CURRENCY=USD

# -----------------------
# Security (NEW)
# -----------------------
# CORS (Cross-Origin Resource Sharing)
CORS_ALLOWED_ORIGINS=       # Comma-separated list, or empty for same-origin only
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=true

# Security Headers
CSP_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=geolocation=(), camera=(), microphone=()
ALLOWED_ORIGINS=            # Comma-separated list for CSP frame-ancestors

# -----------------------
# Payment Security
# -----------------------
PAYMENT_SIGNATURE_SECRET=

# -----------------------
# Production Hardening
# -----------------------
# CRYPTO_SECRET: Shared Redis encryption key (required for multi-machine deployment)
CRYPTO_SECRET=
# STREAMING_TIMEOUT: SSE streaming timeout in seconds (default: 300)
STREAMING_TIMEOUT=300
# MAX_REQUEST_BODY_MB: Max request body size in MB, exceeding returns 413 (default: 32)
MAX_REQUEST_BODY_MB=32
# ERROR_LOG_ENABLED: Separate error log toggle
ERROR_LOG_ENABLED=false

# QRNG_ENABLED: Use quantum random number generator for enhanced cryptographic security
# Seed-once pattern: fetches 64 quantum random bytes at startup, uses locally thereafter
# Zero runtime external dependencies after initial seed
# Falls back to crypto/rand if API is unavailable
# Source URL can point to domestic quantum source:
#  国外(默认): https://qrng.anu.edu.au/API/jsonI.php (ANU澳洲国立大学,免费)
#  国内(自建): http://your-quantum-source/random
#  国内(服务): 百度AI云/阿里云 等商业量子随机数服务
QRNG_ENABLED=true
QRNG_SOURCE_URL=https://qrng.anu.edu.au/API/jsonI.php

# -----------------------
# Network
# -----------------------
HTTPS_PROXY=
RELAY_PROXY=

# -----------------------
# Advanced
# -----------------------
NODE_TYPE=master

# -----------------------
# Docker Compose Variables
# -----------------------
IMAGE_TAG=latest
MYSQL_ROOT_PASSWORD=quantumclaw
MYSQL_DATABASE=quantumclaw
MYSQL_USER=quantumclaw
MYSQL_PASSWORD=quantumclaw
MYSQL_PORT=3306
REDIS_PORT=6379
LOG_DIR=./logs

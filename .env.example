# ============================================================
# QuantumClaw - Environment Configuration
# https://github.com/quantumclaw/quantumclaw
# ============================================================

# ----- Server -----
PORT=3000
GIN_MODE=debug                    # debug / release / test
DEBUG=false
DEBUG_SQL=false                 # Print SQL queries

# ----- Session -----
SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars
# DO NOT use the default value in production!

# ----- Database -----
# SQLite (default, no config needed)
# SQL_DSN=root:password@tcp(localhost:3306)/quantumclaw?charset=utf8mb4&parseTime=True&loc=Local
# PostgreSQL
# SQL_DSN=postgres://user:password@localhost:5432/quantumclaw?sslmode=disable

# Separate log database (optional)
# LOG_SQL_DSN=

# ----- Redis Cache -----
REDIS=localhost:6379
MEMORY_CACHE_ENABLED=true        # Enable in-memory caching for better performance
SYNC_FREQUENCY=600               # Sync frequency in seconds

# ----- SQLite -----
SQLITE_PATH=./data/quantumclaw.db

# ----- Logging -----
LOG_DIR=./logs
ONLY_ONE_LOG_FILE=false

# ----- Initial Root Account -----
# Leave empty to generate a random access token
INITIAL_ROOT_TOKEN=
INITIAL_ROOT_ACCESS_TOKEN=
# Default username: root, password: 123456

# ----- Frontend -----
THEME=default                   # default / berry / air
# FRONTEND_BASE_URL=             # If using external frontend, set URL here

# ----- HTTPS Proxy -----
HTTPS_PROXY=http://localhost:7890

# ----- Request Proxy -----
# Used for outgoing requests to AI providers
RELAY_PROXY=
USER_CONTENT_REQUEST_PROXY=
USER_CONTENT_REQUEST_TIMEOUT=30

# ----- Gemini Settings -----
GEMINI_VERSION=v1              # v1 or vbeta
GEMINI_SAFETY_SETTING=BLOCK_NONE  # HARM_BLOCK_THRESHOLD_UNSPECIFIED / BLOCK_ONLY_HIGH / BLOCK_MEDIUM_AND_ABOVE / BLOCK_LOW_AND_ABOVE / BLOCK_NONE

# ----- Rate Limiting -----
GLOBAL_API_RATE_LIMIT=480
GLOBAL_WEB_RATE_LIMIT=240

# ----- Feature Flags -----
# Automatic channel disable on failure
ENABLE_METRIC=false
METRIC_SUCCESS_RATE_THRESHOLD=0.8
CHANNEL_TEST_FREQUENCY=300      # Channel test interval in seconds (0=disabled)

# Batch update (for high-traffic deployments)
BATCH_UPDATE_ENABLED=false
BATCH_UPDATE_INTERVAL=5

# Retry
RETRY_TIMES=0

# Approximate token counting (faster, less accurate)
APPROXIMATE_TOKEN_ENABLED=false

# Pre-consumed quota per request
PRE_CONSUMED_QUOTA=500

# Enforce include usage in responses
ENFORCE_INCLUDE_USAGE=false

# ----- Node Type -----
# NODE_TYPE=master              # master / slave

# ----- GitHub OAuth -----
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- Lark (Feishu) OAuth -----
LARK_CLIENT_ID=
LARK_CLIENT_SECRET=

# ----- OIDC OAuth -----
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_WELL_KNOWN=                # OIDC discovery endpoint
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=

# ----- WeChat OAuth -----
WECHAT_AUTH_ENABLED=false
WECHAT_SERVER_ADDRESS=
WECHAT_SERVER_TOKEN=

# ----- Turnstile (Anti-bot) -----
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- SMTP Email -----
SMTP_SERVER=
SMTP_PORT=587
SMTP_ACCOUNT=
SMTP_FROM=
SMTP_TOKEN=

# ----- Message Pusher -----
MESSAGE_PUSHER_ADDRESS=
MESSAGE_PUSHER_TOKEN=

# ----- Payments - Stripe -----
STRIPE_ENABLED=false
STRIPE_API_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_MIN_TOPUP=1
STRIPE_UNIT_PRICE=0.002

# ----- Payments - 易支付 (Epay) -----
EPAY_ENABLED=false
EPAY_ID=
EPAY_KEY=
EPAY_ADDRESS=

# ----- Payments - Creem -----
CREEM_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=false
CREEM_PRODUCTS=

# ----- Payments - Waffo -----
WAFFO_ENABLED=false
WAFFO_SANDBOX=false
WAFFO_API_KEY=
WAFFO_SANDBOX_API_KEY=
WAFFO_MIN_TOPUP=1
WAFFO_CURRENCY=USD

# ----- Payments - Common -----
MIN_TOPUP=1
# Comma-separated topup amount options
# AMOUNT_OPTIONS=100,500,1000,5000
PAYMENT_SIGNATURE_SECRET=
PAYMENT_NOTIFY_URL=
PAYMENT_RETURN_URL=

# ----- Security -----
# Comma-separated allowed redirect domains
# ALLOWED_REDIRECT_DOMAINS=example.com,sub.example.com

# ----- Test Prompt -----
TEST_PROMPT=Output only your specific model name with no additional text.

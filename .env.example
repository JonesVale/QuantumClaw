# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=quantumclaw

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRE=24h

# 服务器配置
SERVER_ADDR=:3666
SERVER_MODE=release

# 邮件配置 (可选)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# 支付配置 (闭源模块，需要商业许可)
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=

# 第三方服务 (可选)
# TURNSTILE_SECRET=
# GOOGLE_ANALYTICS_ID=

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 缓存配置
CACHE_TTL=3600

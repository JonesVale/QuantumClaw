# Auto-detect text files and normalize to LF
* text=auto

# Explicit text files with LF
*.json text eol=lf
*.md text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.go text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.bat text eol=crlf
*.ps1 text eol=lf

# Binary files
*.exe binary
*.exe~ binary
*.zip binary
*.tar.gz binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.db-journal binary

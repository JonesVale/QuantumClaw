# ─────────────────────────────────────────────────────
# QuantumClaw Slave Node — Environment Configuration
# ─────────────────────────────────────────────────────
# Copy this to .env and fill in the values.
#
# USAGE:
#   docker compose --env-file .env up -d
# ─────────────────────────────────────────────────────

# === Node Identity (required) ===
NODE_NAME=tokyo-a
CASCADE_NODE_NAME=Tokyo-A
CASCADE_REGION=ap-northeast-1
CASCADE_MASTER_URL=https://master.quantumclaw.com

# === Redis (local) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=qc-redis

# === App ===
PORT=3666
GIN_MODE=release
SESSION_SECRET=must-match-master-session-secret

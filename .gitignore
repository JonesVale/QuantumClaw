# Git 忽略配置

# 环境变量文件
.env
.env.local
.env.*.local
!.env.example

# 编译产物
/bin/
/pkg/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# 依赖
vendor/

# 日志
logs/
*.log
log/

# 数据文件
data/
*.db
*.sqlite
*.sqlite3
backup/

# 配置文件 (可能包含密钥)
config/*.yaml
config/*.yml
config/*.json
config/*.env
!**/config/example*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 测试覆盖
coverage/
*.coverage
*.prof

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.backup

# 密钥文件
**/*.pem
**/*.key
**/*.crt
**/private_keys/
**/certificates/

# 数据库迁移备份
migrations/*.bak
migrations/*.sql.bak

# 上传文件
uploads/
assets/uploads/

# 临时文件
*.tmp
*.temp
*.swp

# 项目特定
.QuantumClaw/
.agens/
backups/
*.sql
!migrations/*.sql

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Node
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
